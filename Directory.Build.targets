<Project>
  <!--
    CadCore projects are outside SpatialViewer.sln during the repository-split
    transition. AssignProjectConfiguration consumes SetConfiguration/SetPlatform
    metadata for out-of-solution ProjectReference items; AdditionalProperties is
    not sufficient for solution configuration propagation.
  -->
  <ItemGroup>
    <ProjectReference Update="..\..\external\SpatialViewer.CadCore\src\**\*.csproj">
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetPlatform>Platform=$(Platform)</SetPlatform>
    </ProjectReference>
  </ItemGroup>
</Project>
