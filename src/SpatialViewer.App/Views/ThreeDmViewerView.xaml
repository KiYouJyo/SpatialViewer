<UserControl x:Class="SpatialViewer.Product.Views.ThreeDmViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SpatialViewer.Product.Controls">
  <Grid x:Name="ThreeDmRoot" Background="{ThemeResource BgPanelBrush}" RowDefinitions="64,*,24" UseLayoutRounding="True" SizeChanged="ThreeDmRoot_SizeChanged">
    <Grid Grid.Row="0" Background="{ThemeResource BgToolbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1" ColumnDefinitions="*,Auto">
      <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <AppBarButton x:Name="LayersButton" x:Uid="CadLayersButton" Label="图层" Click="ToggleLeft_Click"><AppBarButton.Icon><SymbolIcon Symbol="GlobalNavigationButton" /></AppBarButton.Icon></AppBarButton>
          <AppBarButton x:Uid="CadFitButton" Label="适合窗口" Click="Fit_Click"><AppBarButton.Icon><SymbolIcon Symbol="FullScreen" /></AppBarButton.Icon></AppBarButton>
          <ComboBox x:Name="ViewPicker" Width="150" Margin="6,12,0,12" DisplayMemberPath="Name" SelectionChanged="ViewPicker_SelectionChanged" />
          <ComboBox x:Name="DisplayModePicker" Width="150" Margin="6,12,0,12" SelectionChanged="DisplayModePicker_SelectionChanged" />
        </StackPanel>
      </ScrollViewer>
      <AppBarButton Grid.Column="1" x:Name="PropertiesButton" x:Uid="CadPropertiesButton" Label="属性" Click="ToggleRight_Click"><AppBarButton.Icon><SymbolIcon Symbol="OpenPane" /></AppBarButton.Icon></AppBarButton>
    </Grid>

    <SplitView x:Name="LeftPaneHost" Grid.Row="1" DisplayMode="Inline" PanePlacement="Left" IsPaneOpen="True" OpenPaneLength="300" CompactPaneLength="0">
      <SplitView.Pane>
        <Border Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12">
          <Grid RowDefinitions="Auto,10,*">
            <TextBlock x:Uid="ThreeDmLayersTitle" Text="图层" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
            <ListView Grid.Row="2" x:Name="LayerList">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible, Mode=OneWay}" Tag="{Binding Id}" Margin="{Binding Margin}" Click="Layer_Click" />
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>
      </SplitView.Pane>
      <SplitView.Content>
        <SplitView x:Name="RightPaneHost" DisplayMode="Inline" PanePlacement="Right" IsPaneOpen="True" OpenPaneLength="300" CompactPaneLength="0">
          <SplitView.Pane>
            <Border Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12">
              <StackPanel Spacing="10">
                <TextBlock x:Uid="CadPropertiesPanelTitle" Text="属性" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                <InfoBar x:Name="DiagnosticsBar" x:Uid="ThreeDmDiagnosticsBar" IsOpen="False" Severity="Warning" IsClosable="True" />
              </StackPanel>
            </Border>
          </SplitView.Pane>
          <SplitView.Content><controls:ThreeDmViewportControl x:Name="Viewport" /></SplitView.Content>
        </SplitView>
      </SplitView.Content>
    </SplitView>

    <Grid Grid.Row="2" Background="{ThemeResource BgToolbarBrush}" Padding="12,2" ColumnDefinitions="Auto,Auto,*,Auto">
      <TextBlock x:Name="ProgressText" Style="{StaticResource MetadataText}" />
      <TextBlock x:Name="UnitsText" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource MetadataText}" />
      <TextBlock x:Name="ObjectText" Grid.Column="3" Style="{StaticResource MetadataText}" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</UserControl>
