<UserControl x:Class="SpatialViewer.Product.Views.CadViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SpatialViewer.Product.Controls">
  <Grid x:Name="CadRoot" Background="{ThemeResource BgPanelBrush}" RowDefinitions="64,*,24" UseLayoutRounding="True" SizeChanged="CadRoot_SizeChanged">
    <Grid.Resources>
      <Flyout x:Name="LayersFlyout" Placement="Bottom"><Border Width="300" MaxHeight="520" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="8"><TextBlock Text="图层" Style="{StaticResource SectionTitleText}" /><ListView x:Name="OverlayLayerList"><ListView.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Click="Layer_Click" /></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></Flyout>
      <Flyout x:Name="PropertiesFlyout" Placement="Bottom"><Border Width="300" MaxHeight="520" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="8"><TextBlock Text="属性" Style="{StaticResource SectionTitleText}" /><TextBlock x:Name="OverlayPropertiesEmpty" Text="选择一个对象以查看真实 CAD 属性。" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" /><ListView x:Name="OverlayPropertiesList"><ListView.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource MetadataText}" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></Flyout>
    </Grid.Resources>

    <Grid x:Name="ViewerToolbar" Grid.Row="0" Background="{ThemeResource BgToolbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <AppBarButton x:Name="LayersButton" Label="图层" LabelPosition="Default" Click="ToggleLeft_Click"><AppBarButton.Icon><SymbolIcon Symbol="GlobalNavigationButton" /></AppBarButton.Icon></AppBarButton>
        <AppBarToggleButton x:Name="SelectTool" Label="选择" LabelPosition="Default" Click="SelectTool_Click"><AppBarToggleButton.Icon><SymbolIcon Symbol="TouchPointer" /></AppBarToggleButton.Icon></AppBarToggleButton>
        <AppBarToggleButton x:Name="PanTool" Label="平移" LabelPosition="Default" Click="PanTool_Click"><AppBarToggleButton.Icon><SymbolIcon Symbol="Map" /></AppBarToggleButton.Icon></AppBarToggleButton>
        <AppBarButton Label="适合窗口" LabelPosition="Default" Click="Fit_Click"><AppBarButton.Icon><SymbolIcon Symbol="FullScreen" /></AppBarButton.Icon></AppBarButton>
        <AppBarButton Label="测距" LabelPosition="Default" IsEnabled="False"><AppBarButton.Icon><SymbolIcon Symbol="Preview" /></AppBarButton.Icon></AppBarButton>
        <AppBarButton Label="面积" LabelPosition="Default" IsEnabled="False"><AppBarButton.Icon><SymbolIcon Symbol="Map" /></AppBarButton.Icon></AppBarButton>
        <AppBarButton Label="坐标" LabelPosition="Default" IsEnabled="False"><AppBarButton.Icon><SymbolIcon Symbol="Target" /></AppBarButton.Icon></AppBarButton>
        <AppBarButton Label="显示" LabelPosition="Default" IsEnabled="False"><AppBarButton.Icon><SymbolIcon Symbol="View" /></AppBarButton.Icon></AppBarButton>
      </StackPanel>
      <AppBarButton x:Name="PropertiesButton" Label="属性" LabelPosition="Default" HorizontalAlignment="Right" Click="ToggleRight_Click"><AppBarButton.Icon><SymbolIcon Symbol="OpenPane" /></AppBarButton.Icon></AppBarButton>
    </Grid>

    <SplitView x:Name="LeftPaneHost" Grid.Row="1" DisplayMode="Inline" PanePlacement="Left" IsPaneOpen="True" OpenPaneLength="300" CompactPaneLength="0">
      <SplitView.Pane>
        <Border x:Name="LeftPanel" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12">
          <Grid RowDefinitions="Auto,10,*"><Grid ColumnDefinitions="Auto,*"><Button Style="{StaticResource PanelSegmentActive}" Content="图层" /><Button Grid.Column="1" Style="{StaticResource PanelSegment}" Content="布局（暂未支持）" HorizontalAlignment="Left" Margin="8,0,0,0" IsEnabled="False" /></Grid><ListView Grid.Row="2" x:Name="LayerList" SelectionChanged="LayerList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Click="Layer_Click" /></DataTemplate></ListView.ItemTemplate></ListView></Grid>
        </Border>
      </SplitView.Pane>
      <SplitView.Content>
        <SplitView x:Name="RightPaneHost" DisplayMode="Inline" PanePlacement="Right" IsPaneOpen="True" OpenPaneLength="300" CompactPaneLength="0">
          <SplitView.Pane>
            <Border x:Name="RightPanel" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12"><StackPanel Spacing="10"><TextBlock Text="属性" Style="{StaticResource BodyText}" FontWeight="SemiBold" /><TextBlock x:Name="PropertiesEmpty" Text="选择一个对象以查看真实 CAD 属性。" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" /><ListView x:Name="PropertiesList"><ListView.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource MetadataText}" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><InfoBar x:Name="DiagnosticsBar" IsOpen="False" Severity="Warning" Title="图纸包含暂不支持的对象" IsClosable="True" /></StackPanel></Border>
          </SplitView.Pane>
          <SplitView.Content><controls:CadViewportControl x:Name="Viewport" /></SplitView.Content>
        </SplitView>
      </SplitView.Content>
    </SplitView>

    <Grid Grid.Row="2" Background="{ThemeResource BgToolbarBrush}" Padding="12,2" ColumnDefinitions="Auto,Auto,Auto,*,Auto"><TextBlock x:Name="CoordinateText" Style="{StaticResource MetadataText}" /><TextBlock x:Name="ZoomText" Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource MetadataText}" /><TextBlock x:Name="UnitsText" Grid.Column="2" Margin="18,0,0,0" Style="{StaticResource MetadataText}" /><TextBlock x:Name="ObjectText" Grid.Column="4" Style="{StaticResource MetadataText}" TextTrimming="CharacterEllipsis" /></Grid>
  </Grid>
</UserControl>
