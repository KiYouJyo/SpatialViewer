<UserControl x:Class="SpatialViewer.Product.Views.CadViewerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:SpatialViewer.Product.Controls">
  <Grid Background="{ThemeResource BgPanelBrush}" RowDefinitions="51,*,24">
    <Grid Grid.Row="0" Background="{ThemeResource BgToolbarBrush}" Padding="8,4" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"><Button Content="☰" Style="{StaticResource ToolButton}" Click="ToggleLeft_Click" ToolTipService.ToolTip="折叠图层面板" /><Button x:Name="SelectTool" Grid.Column="1" Content="⌖" Style="{StaticResource ToolButton}" Click="SelectTool_Click" ToolTipService.ToolTip="选择" /><Button x:Name="PanTool" Grid.Column="2" Content="✋" Style="{StaticResource ToolButton}" Click="PanTool_Click" ToolTipService.ToolTip="平移" /><Button x:Name="ZoomTool" Grid.Column="3" Content="⌕" Style="{StaticResource ToolButton}" Click="ZoomTool_Click" ToolTipService.ToolTip="缩放（鼠标滚轮始终可用）" /><Button Grid.Column="4" Content="适合窗口" Style="{StaticResource CompactButton}" Click="Fit_Click" /><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="12,0"><Button Content="测距" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTipService.ToolTip="暂未实现" /><Button Content="面积" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTipService.ToolTip="暂未实现" /><Button Content="坐标" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTipService.ToolTip="暂未实现" /></StackPanel><Button Grid.Column="6" Content="▥" Style="{StaticResource ToolButton}" Click="ToggleRight_Click" ToolTipService.ToolTip="折叠属性面板" /></Grid>
    <Grid Grid.Row="1" x:Name="WorkspaceGrid" ColumnDefinitions="300,*,300">
      <Border x:Name="LeftPanel" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12"><StackPanel Spacing="10"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="图层" FontWeight="SemiBold" /><TextBlock Text="布局（暂未支持）" Foreground="{ThemeResource TextSecondaryBrush}" /></StackPanel><ListView x:Name="LayerList" SelectionChanged="LayerList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Click="Layer_Click" /></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
      <controls:CadViewportControl x:Name="Viewport" Grid.Column="1" />
      <Border x:Name="RightPanel" Grid.Column="2" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1,0,0,0" Padding="12"><StackPanel Spacing="10"><TextBlock Text="属性" FontWeight="SemiBold" /><TextBlock x:Name="PropertiesEmpty" Text="选择一个对象以查看真实 CAD 属性。" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" /><ListView x:Name="PropertiesList"><ListView.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><InfoBar x:Name="DiagnosticsBar" IsOpen="False" Severity="Warning" Title="图纸包含暂不支持的对象" IsClosable="True" /></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="2" Background="{ThemeResource BgToolbarBrush}" Padding="8,2" ColumnDefinitions="Auto,Auto,Auto,*,Auto"><TextBlock x:Name="CoordinateText" /><TextBlock x:Name="ZoomText" Grid.Column="1" Margin="18,0,0,0" /><TextBlock x:Name="UnitsText" Grid.Column="2" Margin="18,0,0,0" /><TextBlock x:Name="ObjectText" Grid.Column="4" /></Grid>
  </Grid>
</UserControl>
