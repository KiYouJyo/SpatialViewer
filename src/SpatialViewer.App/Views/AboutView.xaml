<UserControl x:Class="SpatialViewer.Product.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SpatialViewer.Product.Controls">
  <ScrollViewer x:Name="AboutScrollViewer" Background="Transparent" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="AboutRoot" Width="{Binding ActualWidth, ElementName=AboutScrollViewer}" Padding="24" RowDefinitions="Auto,24,Auto,18,Auto,18,Auto" UseLayoutRounding="True" SizeChanged="AboutRoot_SizeChanged">
      <TextBlock Text="关于图览" Style="{StaticResource DisplayTitleText}" />

      <Border Grid.Row="2" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="58,16,*,Auto" MinHeight="58">
            <Border Width="58" Height="58" Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12">
              <TextBlock Text="◇" FontSize="34" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="图览" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
              <TextBlock Text="建筑、规划与空间数据统一查看器" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextSecondaryBrush}" />
              <TextBlock Text="CAD · GIS · BIM · Rhino Viewer" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="3" Padding="10,3" CornerRadius="6" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="Preview" Style="{StaticResource MetadataText}" /></Border>
          </Grid>

          <Border Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid x:Name="AppMetadataGrid" ColumnSpacing="24" ColumnDefinitions="*,*,*">
              <StackPanel Spacing="10"><StackPanel><TextBlock Text="显示版本" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock Text="v0.2 Preview" /></StackPanel><StackPanel><TextBlock Text="发布渠道" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock Text="Preview" /></StackPanel></StackPanel>
              <StackPanel Grid.Column="1" Spacing="10"><StackPanel><TextBlock Text="内部版本" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock Text="0.2-preview" /></StackPanel><StackPanel><TextBlock Text="发行者" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock Text="图览" /></StackPanel></StackPanel>
              <StackPanel Grid.Column="2" Spacing="10"><StackPanel><TextBlock Text="当前架构" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock Text="X64" /></StackPanel><StackPanel><TextBlock Text="技术栈" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock Text="C# · WinUI 3 · Windows App SDK" TextWrapping="Wrap" /></StackPanel></StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="© 2026 SpatialViewer" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel Spacing="14">
          <TextBlock Text="更新管理" Style="{StaticResource SectionTitleText}" />
          <Border Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid x:Name="AppUpdateGrid" ColumnDefinitions="2*,110,32,110,150,130,Auto,Auto" ColumnSpacing="10" MinHeight="44">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="SpatialViewer 主程序" FontWeight="SemiBold" /><TextBlock Text="应用更新" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="当前版本" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock Text="v0.2 Preview" /></StackPanel>
              <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
              <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="可用版本" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock x:Name="AvailableAppVersionText" Text="—" /></StackPanel>
              <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="更新来源" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock Text="GitHub Releases" /></StackPanel>
              <StackPanel Grid.Column="5" VerticalAlignment="Center"><TextBlock Text="状态" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /><TextBlock x:Name="AppUpdateStatusText" Text="尚未检查更新" TextWrapping="Wrap" /></StackPanel>
              <Button Grid.Column="6" Content="发行说明" MinWidth="96" VerticalAlignment="Center" Click="ReleaseNotesButton_Click" />
              <Button x:Name="CheckAppUpdateButton" Grid.Column="7" Content="检查更新" MinWidth="108" VerticalAlignment="Center" Click="CheckAppUpdateButton_Click" />
            </Grid>
          </Border>

          <TextBlock Text="查看内核" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
          <Border Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="46,1,46,1,46,1,46">
              <Grid Padding="14,0" ColumnDefinitions="2*,110,110,170,140,Auto" ColumnSpacing="10">
                <TextBlock Text="CAD 图形内核" VerticalAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="1" x:Name="CadCurrentVersionText" Text="已独立" VerticalAlignment="Center" /><TextBlock Grid.Column="2" x:Name="CadAvailableVersionText" Text="—" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="独立仓库" VerticalAlignment="Center" /><TextBlock Grid.Column="4" x:Name="CadUpdateStatusText" Text="尚未检查" VerticalAlignment="Center" /><Button Grid.Column="5" Content="检查更新" MinWidth="92" VerticalAlignment="Center" Click="CheckCadUpdateButton_Click" />
              </Grid>
              <Border Grid.Row="1" Background="{ThemeResource BorderBrush}" />
              <Grid Grid.Row="2" Padding="14,0" ColumnDefinitions="2*,110,110,170,140,Auto" ColumnSpacing="10"><TextBlock Text="GIS 数据内核" VerticalAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="随应用" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="预留独立源" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="尚未接入" VerticalAlignment="Center" /><Button Grid.Column="5" Content="检查更新" MinWidth="92" IsEnabled="False" VerticalAlignment="Center" /></Grid>
              <Border Grid.Row="3" Background="{ThemeResource BorderBrush}" />
              <Grid Grid.Row="4" Padding="14,0" ColumnDefinitions="2*,110,110,170,140,Auto" ColumnSpacing="10"><TextBlock Text="IFC 模型内核" VerticalAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="随应用" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="预留独立源" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="尚未接入" VerticalAlignment="Center" /><Button Grid.Column="5" Content="检查更新" MinWidth="92" IsEnabled="False" VerticalAlignment="Center" /></Grid>
              <Border Grid.Row="5" Background="{ThemeResource BorderBrush}" />
              <Grid Grid.Row="6" Padding="14,0" ColumnDefinitions="2*,110,110,170,140,Auto" ColumnSpacing="10"><TextBlock Text="Rhino 3DM 内核" VerticalAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="随应用" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="预留独立源" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="尚未接入" VerticalAlignment="Center" /><Button Grid.Column="5" Content="检查更新" MinWidth="92" IsEnabled="False" VerticalAlignment="Center" /></Grid>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="6" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
        <StackPanel Spacing="14">
          <TextBlock Text="项目与开源" Style="{StaticResource SectionTitleText}" />
          <Grid x:Name="ProjectLinksGrid" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid RowDefinitions="Auto,Auto,16,Auto"><TextBlock Text="GitHub 仓库" FontWeight="SemiBold" FontSize="16" /><TextBlock Grid.Row="1" Text="查看源码、README 与开发进度。" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" /><Button Grid.Row="3" Content="打开仓库" HorizontalAlignment="Left" Click="OpenRepositoryButton_Click" /></Grid></Border>
            <Border Grid.Column="1" Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid RowDefinitions="Auto,Auto,16,Auto"><TextBlock Text="Releases" FontWeight="SemiBold" FontSize="16" /><TextBlock Grid.Row="1" Text="查看历史版本、安装包与发行说明。" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" /><Button Grid.Row="3" Content="查看版本" HorizontalAlignment="Left" Click="OpenReleasesButton_Click" /></Grid></Border>
            <Border Grid.Column="2" Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><Grid RowDefinitions="Auto,Auto,16,Auto"><TextBlock Text="许可与隐私" FontWeight="SemiBold" FontSize="16" /><TextBlock Grid.Row="1" Text="查看第三方组件许可与本地文件策略。" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" /><Button Grid.Row="3" Content="查看说明" HorizontalAlignment="Left" Click="OpenPrivacyButton_Click" /></Grid></Border>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
