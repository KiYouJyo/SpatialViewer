<UserControl x:Class="SpatialViewer.Product.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="AboutScrollViewer" Background="Transparent"
                HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="AboutRoot" HorizontalAlignment="Stretch" Padding="24,16,24,32" UseLayoutRounding="True" SizeChanged="AboutRoot_SizeChanged">
      <StackPanel Spacing="18" HorizontalAlignment="Stretch">
        <TextBlock x:Name="AboutTitleText" Text="关于图览" Style="{StaticResource DisplayTitleText}" />

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="58,16,*,Auto" MinHeight="58">
              <Border Width="58" Height="58" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <TextBlock Text="◇" FontSize="34" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="图览" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="TaglineText" Text="建筑、规划与空间数据统一查看器" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="CAD · GIS · BIM · Rhino Viewer" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <Border Grid.Column="3" Padding="10,3" CornerRadius="6" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="Preview" Style="{StaticResource MetadataText}" /></Border>
            </Grid>

            <Border Style="{StaticResource SettingsInnerCardStyle}" Padding="14">
              <Grid x:Name="MetadataGrid" ColumnSpacing="24" RowSpacing="14" ColumnDefinitions="*,*,*">
                <StackPanel x:Name="MetadataColumn0" Spacing="10"><StackPanel><TextBlock x:Name="DisplayVersionLabel" Text="显示版本" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock Text="v0.2.1 Preview" /></StackPanel><StackPanel><TextBlock x:Name="ChannelLabel" Text="发布渠道" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock Text="Preview" /></StackPanel></StackPanel>
                <StackPanel x:Name="MetadataColumn1" Grid.Column="1" Spacing="10"><StackPanel><TextBlock x:Name="InternalVersionLabel" Text="内部版本" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock Text="0.2.1-preview" /></StackPanel><StackPanel><TextBlock x:Name="PublisherLabel" Text="发行者" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock Text="Jo Kiyō" /></StackPanel></StackPanel>
                <StackPanel x:Name="MetadataColumn2" Grid.Column="2" Spacing="10"><StackPanel><TextBlock x:Name="ArchitectureLabel" Text="当前架构" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock Text="X64" /></StackPanel><StackPanel><TextBlock x:Name="TechStackLabel" Text="技术栈" Style="{StaticResource SettingsDescriptionStyle}" /><TextBlock Text="C# · WinUI 3 · Windows App SDK" TextWrapping="Wrap" /></StackPanel></StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="© 2026 SpatialViewer" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <StackPanel Spacing="14">
            <TextBlock x:Name="UpdateManagementTitleText" Text="更新管理" Style="{StaticResource SectionTitleText}" />
            <Border Style="{StaticResource SettingsInnerCardStyle}" Padding="14">
              <Grid x:Name="AppUpdateGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock x:Name="AppProgramTitleText" Text="SpatialViewer 主程序" Style="{StaticResource SettingsRowLabelStyle}" />
                  <TextBlock x:Name="AppUpdateDescriptionText" Text="应用更新" Style="{StaticResource SettingsDescriptionStyle}" />
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="CurrentVersionLabel" Text="当前版本" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="v0.2.1 Preview" /><TextBlock Text="·" Opacity="0.55" /><TextBlock x:Name="AvailableVersionLabel" Text="可用版本" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="AvailableAppVersionText" Text="—" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="UpdateSourceLabel" Text="更新来源" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="GitHub Releases" /></StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="StatusLabel" Text="状态" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="AppUpdateStatusText" Text="尚未检查" TextWrapping="Wrap" /></StackPanel>
                </StackPanel>
                <StackPanel x:Name="AppUpdateButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button x:Name="ReleaseNotesButton" Content="发行说明" Click="ReleaseNotesButton_Click" />
                  <Button x:Name="CheckAppUpdateButton" Content="检查更新" Click="CheckAppUpdateButton_Click" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock x:Name="KernelsTitleText" Text="查看内核" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
            <Border Style="{StaticResource SettingsInnerCardStyle}">
              <StackPanel>
                <Grid x:Name="CadCoreGrid" Padding="14" MinHeight="64" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="SpatialViewer.CadCore" FontWeight="SemiBold" /><TextBlock x:Name="CadCoreDescriptionText" Text="CAD 图形内核 · SpatialViewer.CadCore" Style="{StaticResource SettingsDescriptionStyle}" /><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="CadAvailableVersionText" Text="—" /><TextBlock Text="·" Opacity="0.55" /><TextBlock x:Name="CadUpdateStatusText" Text="尚未检查" /></StackPanel></StackPanel>
                  <StackPanel x:Name="CadCoreButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="SpatialViewer.CadCore" Click="OpenCadCoreRepositoryButton_Click" /><Button x:Name="CheckCadUpdateButton" Content="检查更新" Click="CheckCadUpdateButton_Click" /></StackPanel>
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Padding="14" MinHeight="56" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="GIS Core" FontWeight="SemiBold" /><TextBlock Text="Planned" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><Button Grid.Column="1" x:Name="DisabledCheckButton1" Content="检查更新" IsEnabled="False" /></Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Padding="14" MinHeight="56" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="IFC Core" FontWeight="SemiBold" /><TextBlock Text="Planned" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><Button Grid.Column="1" x:Name="DisabledCheckButton2" Content="检查更新" IsEnabled="False" /></Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Padding="14" MinHeight="56" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Rhino 3DM Core" FontWeight="SemiBold" /><TextBlock Text="Planned" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><Button Grid.Column="1" x:Name="DisabledCheckButton3" Content="检查更新" IsEnabled="False" /></Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0,0,0,24">
          <StackPanel Spacing="14">
            <TextBlock x:Name="ProjectOpenSourceTitleText" Text="项目与开源" Style="{StaticResource SectionTitleText}" />
            <Grid x:Name="ProjectLinksGrid" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="12">
              <Border x:Name="RepositoryCard" Style="{StaticResource SettingsInnerCardStyle}" Padding="14"><Grid RowDefinitions="Auto,Auto,16,Auto"><TextBlock x:Name="RepositoryTitleText" Text="GitHub 仓库" FontWeight="SemiBold" FontSize="16" /><TextBlock x:Name="RepositoryDescriptionText" Grid.Row="1" Text="查看源码、README 与开发进度。" Style="{StaticResource SettingsDescriptionStyle}" /><Button x:Name="OpenRepositoryButton" Grid.Row="3" Content="打开仓库" HorizontalAlignment="Left" Click="OpenRepositoryButton_Click" /></Grid></Border>
              <Border x:Name="ReleasesCard" Grid.Column="1" Style="{StaticResource SettingsInnerCardStyle}" Padding="14"><Grid RowDefinitions="Auto,Auto,16,Auto"><TextBlock Text="Releases" FontWeight="SemiBold" FontSize="16" /><TextBlock x:Name="ReleasesDescriptionText" Grid.Row="1" Text="查看历史版本、安装包与发行说明。" Style="{StaticResource SettingsDescriptionStyle}" /><Button x:Name="OpenReleasesButton" Grid.Row="3" Content="查看版本" HorizontalAlignment="Left" Click="OpenReleasesButton_Click" /></Grid></Border>
              <Border x:Name="PrivacyCard" Grid.Column="2" Style="{StaticResource SettingsInnerCardStyle}" Padding="14"><Grid RowDefinitions="Auto,Auto,16,Auto"><TextBlock x:Name="LicensePrivacyTitleText" Text="许可与隐私" FontWeight="SemiBold" FontSize="16" /><TextBlock x:Name="LicensePrivacyDescriptionText" Grid.Row="1" Text="查看第三方组件许可与本地文件策略。" Style="{StaticResource SettingsDescriptionStyle}" /><Button x:Name="OpenPrivacyButton" Grid.Row="3" Content="查看说明" HorizontalAlignment="Left" Click="OpenPrivacyButton_Click" /></Grid></Border>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
