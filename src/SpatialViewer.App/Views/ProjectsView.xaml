<UserControl x:Class="SpatialViewer.Product.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SpatialViewer.Product.Controls"
             xmlns:local="using:SpatialViewer.Product.Views">
  <UserControl.Resources>
    <DataTemplate x:Key="ProjectCardTemplate" x:DataType="local:ProjectViewItem">
      <Button Tag="{x:Bind Id}" Click="ProjectCard_Click"
              Height="130" Padding="18,16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid ColumnDefinitions="*,24" RowDefinitions="Auto,10,Auto,*,Auto">
          <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleText}" FontSize="17" TextTrimming="CharacterEllipsis" />
          <FontIcon Grid.Column="1" Grid.RowSpan="5" Glyph="&#xE72A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"
                    Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{x:Bind FileCountText}" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBlock Text="{x:Bind FormatSummary}" Style="{StaticResource TagText}" Foreground="{ThemeResource AccentBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Row="4" Text="{x:Bind LastOpenedText}" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Padding="24" RowDefinitions="Auto,16,Auto,14,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" UseLayoutRounding="True">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="TitleText" Text="项目" Style="{StaticResource DisplayTitleText}" VerticalAlignment="Center" />
        <Button x:Name="NewProjectButton" Grid.Column="1" Style="{StaticResource HeaderActionButton}" Click="NewProjectButton_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
            <TextBlock x:Name="NewProjectButtonText" Text="新建项目" Style="{StaticResource TabText}" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="*,344" ColumnSpacing="16">
        <TextBlock x:Name="SummaryText" Text="将相关图纸与空间数据组织为可重复打开的项目。" Style="{StaticResource BodyText}"
                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索项目" TextChanged="SearchBox_TextChanged" />
      </Grid>

      <Grid Grid.Row="4">
        <ItemsRepeater x:Name="ProjectRepeater" ItemsSource="{x:Bind VisibleItems}" ItemTemplate="{StaticResource ProjectCardTemplate}">
          <ItemsRepeater.Layout>
            <UniformGridLayout MinItemWidth="420" MinItemHeight="130" MinRowSpacing="12" MinColumnSpacing="12"
                               ItemsStretch="Fill" ItemsJustification="Start" />
          </ItemsRepeater.Layout>
        </ItemsRepeater>
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0" Spacing="10">
          <controls:AppIcon Kind="OpenFile" IconSize="28" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyStateText" Text="还没有项目。使用“新建项目”或“导入文件夹”开始。" Style="{StaticResource BodyText}"
                     Foreground="{ThemeResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
