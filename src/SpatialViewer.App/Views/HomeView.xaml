<UserControl x:Class="SpatialViewer.Product.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Background="{ThemeResource BgSurfaceBrush}">
    <StackPanel Padding="24" Spacing="16">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="图览" FontSize="30" FontWeight="SemiBold" /><Button Grid.Column="1" Content="＋  打开文件" Style="{StaticResource CompactButton}" Click="Open_Click" AutomationProperties.Name="打开 DWG 或 DXF 文件" /></Grid>
      <Border Background="{ThemeResource BgToolbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,16">
        <StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="快速打开" FontSize="18" FontWeight="SemiBold" /><Border Background="{ThemeResource BgSelectionBrush}" CornerRadius="5" Padding="8,4"><TextBlock Text="DWG · DXF" Foreground="{ThemeResource AccentBrush}" FontSize="11" /></Border></StackPanel><Border Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="44" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"><TextBlock Text="▧   将 DWG 或 DXF 拖到这里" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border></StackPanel>
      </Border>
      <TextBlock Text="支持的工作流" FontSize="18" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12"><Button Content="CAD&#x0a;DWG / DXF" Style="{StaticResource CompactButton}" Click="Open_Click" HorizontalContentAlignment="Left" Height="80" /><Button Grid.Column="1" Content="GIS&#x0a;开发中" Style="{StaticResource CompactButton}" IsEnabled="False" HorizontalContentAlignment="Left" Height="80" ToolTipService.ToolTip="暂未实现" /><Button Grid.Column="2" Content="BIM&#x0a;开发中" Style="{StaticResource CompactButton}" IsEnabled="False" HorizontalContentAlignment="Left" Height="80" ToolTipService.ToolTip="暂未实现" /><Button Grid.Column="3" Content="Rhino&#x0a;开发中" Style="{StaticResource CompactButton}" IsEnabled="False" HorizontalContentAlignment="Left" Height="80" ToolTipService.ToolTip="暂未实现" /></Grid>
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="最近打开" FontSize="18" FontWeight="SemiBold" /><TextBox x:Name="SearchBox" Grid.Column="1" Width="240" PlaceholderText="搜索文件" TextChanged="SearchBox_TextChanged" /></Grid>
      <ListView x:Name="RecentFiles" SelectionChanged="RecentFiles_SelectionChanged" IsItemClickEnabled="True"><ListView.ItemTemplate><DataTemplate><Grid Padding="12,8" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Extension}" VerticalAlignment="Center" Foreground="{ThemeResource AccentBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
      <TextBlock x:Name="EmptyState" Text="尚未打开任何图纸。使用上方按钮或拖放区域打开 DWG / DXF。" Foreground="{ThemeResource TextSecondaryBrush}" Margin="12,20" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
