<UserControl x:Class="SpatialViewer.Product.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="SettingsScrollViewer" Background="{ThemeResource BgSurfaceBrush}" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Width="{Binding ActualWidth, ElementName=SettingsScrollViewer}" Padding="24" RowDefinitions="Auto,16,Auto,16,Auto" UseLayoutRounding="True">
      <TextBlock Text="设置" Style="{StaticResource DisplayTitleText}" />
      <Border Grid.Row="2" Background="{ThemeResource BgToolbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel Spacing="12"><TextBlock Text="外观" Style="{StaticResource SectionTitleText}" /><ComboBox x:Name="ThemePicker" Header="主题" SelectionChanged="ThemePicker_SelectionChanged"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox><TextBlock Text="查看器画布默认使用黑色背景，以保持 CAD 图纸颜色语义。" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border>
      <Border Grid.Row="4" Background="{ThemeResource BgToolbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel Spacing="8"><TextBlock Text="语言" Style="{StaticResource SectionTitleText}" /><TextBlock Text="简体中文 / 日本語 / English 的资源基础已准备；完整本地化持续完善中。" Style="{StaticResource BodyText}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border>
    </Grid>
  </ScrollViewer>
</UserControl>
