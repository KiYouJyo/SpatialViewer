<UserControl x:Class="SpatialViewer.Product.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SpatialViewer.Product.Controls">
  <ScrollViewer x:Name="SettingsScrollViewer" Background="Transparent" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Width="{Binding ActualWidth, ElementName=SettingsScrollViewer}" Padding="24" RowDefinitions="Auto,24,Auto,18,Auto,18,Auto" UseLayoutRounding="True">
      <TextBlock Text="设置" Style="{StaticResource DisplayTitleText}" />

      <Border Grid.Row="2" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel Spacing="14">
          <TextBlock Text="外观与语言" Style="{StaticResource SectionTitleText}" />
          <Border Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="68,1,68">
              <Grid Padding="16,0" ColumnDefinitions="*,Auto">
                <TextBlock Text="主题" VerticalAlignment="Center" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemePicker" Grid.Column="1" Width="170" VerticalAlignment="Center" controls:TransientComboBoxTheme.Apply="True" SelectionChanged="ThemePicker_SelectionChanged">
                  <ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" />
                </ComboBox>
              </Grid>
              <Border Grid.Row="1" Background="{ThemeResource BorderBrush}" />
              <Grid Grid.Row="2" Padding="16,0" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="语言" Style="{StaticResource BodyText}" FontWeight="SemiBold" /><TextBlock Text="切换后将在下次启动时应用到全部资源。" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /></StackPanel>
                <ComboBox x:Name="LanguagePicker" Grid.Column="1" Width="170" VerticalAlignment="Center" controls:TransientComboBoxTheme.Apply="True" SelectionChanged="LanguagePicker_SelectionChanged">
                  <ComboBoxItem Content="简体中文" /><ComboBoxItem Content="日本語" /><ComboBoxItem Content="English" />
                </ComboBox>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel Spacing="14">
          <TextBlock Text="文件与会话" Style="{StaticResource SectionTitleText}" />
          <Border Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="68,1,68,1,68">
              <Grid Padding="16,0" ColumnDefinitions="*,Auto"><TextBlock Text="启动时恢复上次会话" VerticalAlignment="Center" Style="{StaticResource BodyText}" FontWeight="SemiBold" /><ToggleSwitch x:Name="RestoreSessionToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="RestoreSessionToggle_Toggled" /></Grid>
              <Border Grid.Row="1" Background="{ThemeResource BorderBrush}" />
              <Grid Grid.Row="2" Padding="16,0" ColumnDefinitions="*,Auto"><TextBlock Text="记录最近打开文件" VerticalAlignment="Center" Style="{StaticResource BodyText}" FontWeight="SemiBold" /><ToggleSwitch x:Name="RecentFilesToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="RecentFilesToggle_Toggled" /></Grid>
              <Border Grid.Row="3" Background="{ThemeResource BorderBrush}" />
              <Grid Grid.Row="4" Padding="16,0" ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="自动检查文件变化" Style="{StaticResource BodyText}" FontWeight="SemiBold" /><TextBlock Text="打开的图纸被外部修改后自动重新读取。" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" /></StackPanel><ToggleSwitch x:Name="WatchFilesToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="WatchFilesToggle_Toggled" /></Grid>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="6" Background="{ThemeResource BgPanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
        <StackPanel Spacing="14">
          <TextBlock Text="查看器" Style="{StaticResource SectionTitleText}" />
          <Border Background="{ThemeResource BgSelectionBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="68,1,68,1,68">
              <Grid Padding="16,0" ColumnDefinitions="*,Auto"><TextBlock Text="打开文件后适合窗口" VerticalAlignment="Center" Style="{StaticResource BodyText}" FontWeight="SemiBold" /><ToggleSwitch x:Name="FitOnOpenToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="FitOnOpenToggle_Toggled" /></Grid>
              <Border Grid.Row="1" Background="{ThemeResource BorderBrush}" />
              <Grid Grid.Row="2" Padding="16,0" ColumnDefinitions="*,Auto"><TextBlock Text="查看器主题" VerticalAlignment="Center" Style="{StaticResource BodyText}" FontWeight="SemiBold" /><ComboBox x:Name="ViewerThemePicker" Grid.Column="1" Width="170" VerticalAlignment="Center" controls:TransientComboBoxTheme.Apply="True" SelectionChanged="ViewerThemePicker_SelectionChanged"><ComboBoxItem Content="跟随应用" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox></Grid>
              <Border Grid.Row="3" Background="{ThemeResource BorderBrush}" />
              <Grid Grid.Row="4" Padding="16,0" ColumnDefinitions="*,Auto"><TextBlock Text="图纸背景颜色" VerticalAlignment="Center" Style="{StaticResource BodyText}" FontWeight="SemiBold" /><ComboBox x:Name="DrawingBackgroundPicker" Grid.Column="1" Width="170" VerticalAlignment="Center" controls:TransientComboBoxTheme.Apply="True" SelectionChanged="DrawingBackgroundPicker_SelectionChanged"><ComboBoxItem Content="跟随模式" /><ComboBoxItem Content="黑色" /><ComboBoxItem Content="白色" /></ComboBox></Grid>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
