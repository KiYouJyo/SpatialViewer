<UserControl x:Class="SpatialViewer.Product.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SpatialViewer.Product.Controls">
  <ScrollViewer x:Name="SettingsScrollViewer" Background="Transparent"
                HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="SettingsLayoutRoot" HorizontalAlignment="Stretch" Padding="24,16,24,32" UseLayoutRounding="True">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="SettingsResponsiveStates">
          <VisualState x:Name="SettingsCompact">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="ThemePicker.(Grid.Row)" Value="1" /><Setter Target="ThemePicker.(Grid.Column)" Value="0" /><Setter Target="ThemePicker.(Grid.ColumnSpan)" Value="2" /><Setter Target="ThemePicker.HorizontalAlignment" Value="Left" />
              <Setter Target="LanguagePicker.(Grid.Row)" Value="1" /><Setter Target="LanguagePicker.(Grid.Column)" Value="0" /><Setter Target="LanguagePicker.(Grid.ColumnSpan)" Value="2" /><Setter Target="LanguagePicker.HorizontalAlignment" Value="Left" />
              <Setter Target="RestoreSessionToggle.(Grid.Row)" Value="1" /><Setter Target="RestoreSessionToggle.(Grid.Column)" Value="0" /><Setter Target="RestoreSessionToggle.(Grid.ColumnSpan)" Value="2" /><Setter Target="RestoreSessionToggle.HorizontalAlignment" Value="Left" />
              <Setter Target="RecentFilesToggle.(Grid.Row)" Value="1" /><Setter Target="RecentFilesToggle.(Grid.Column)" Value="0" /><Setter Target="RecentFilesToggle.(Grid.ColumnSpan)" Value="2" /><Setter Target="RecentFilesToggle.HorizontalAlignment" Value="Left" />
              <Setter Target="WatchFilesToggle.(Grid.Row)" Value="1" /><Setter Target="WatchFilesToggle.(Grid.Column)" Value="0" /><Setter Target="WatchFilesToggle.(Grid.ColumnSpan)" Value="2" /><Setter Target="WatchFilesToggle.HorizontalAlignment" Value="Left" />
              <Setter Target="FitOnOpenToggle.(Grid.Row)" Value="1" /><Setter Target="FitOnOpenToggle.(Grid.Column)" Value="0" /><Setter Target="FitOnOpenToggle.(Grid.ColumnSpan)" Value="2" /><Setter Target="FitOnOpenToggle.HorizontalAlignment" Value="Left" />
              <Setter Target="DrawingBackgroundPicker.(Grid.Row)" Value="1" /><Setter Target="DrawingBackgroundPicker.(Grid.Column)" Value="0" /><Setter Target="DrawingBackgroundPicker.(Grid.ColumnSpan)" Value="2" /><Setter Target="DrawingBackgroundPicker.HorizontalAlignment" Value="Left" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="SettingsWide">
            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="ThemePicker.(Grid.Row)" Value="0" /><Setter Target="ThemePicker.(Grid.Column)" Value="1" /><Setter Target="ThemePicker.(Grid.ColumnSpan)" Value="1" /><Setter Target="ThemePicker.HorizontalAlignment" Value="Right" />
              <Setter Target="LanguagePicker.(Grid.Row)" Value="0" /><Setter Target="LanguagePicker.(Grid.Column)" Value="1" /><Setter Target="LanguagePicker.(Grid.ColumnSpan)" Value="1" /><Setter Target="LanguagePicker.HorizontalAlignment" Value="Right" />
              <Setter Target="RestoreSessionToggle.(Grid.Row)" Value="0" /><Setter Target="RestoreSessionToggle.(Grid.Column)" Value="1" /><Setter Target="RestoreSessionToggle.(Grid.ColumnSpan)" Value="1" /><Setter Target="RestoreSessionToggle.HorizontalAlignment" Value="Right" />
              <Setter Target="RecentFilesToggle.(Grid.Row)" Value="0" /><Setter Target="RecentFilesToggle.(Grid.Column)" Value="1" /><Setter Target="RecentFilesToggle.(Grid.ColumnSpan)" Value="1" /><Setter Target="RecentFilesToggle.HorizontalAlignment" Value="Right" />
              <Setter Target="WatchFilesToggle.(Grid.Row)" Value="0" /><Setter Target="WatchFilesToggle.(Grid.Column)" Value="1" /><Setter Target="WatchFilesToggle.(Grid.ColumnSpan)" Value="1" /><Setter Target="WatchFilesToggle.HorizontalAlignment" Value="Right" />
              <Setter Target="FitOnOpenToggle.(Grid.Row)" Value="0" /><Setter Target="FitOnOpenToggle.(Grid.Column)" Value="1" /><Setter Target="FitOnOpenToggle.(Grid.ColumnSpan)" Value="1" /><Setter Target="FitOnOpenToggle.HorizontalAlignment" Value="Right" />
              <Setter Target="DrawingBackgroundPicker.(Grid.Row)" Value="0" /><Setter Target="DrawingBackgroundPicker.(Grid.Column)" Value="1" /><Setter Target="DrawingBackgroundPicker.(Grid.ColumnSpan)" Value="1" /><Setter Target="DrawingBackgroundPicker.HorizontalAlignment" Value="Right" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <StackPanel x:Name="SettingsContent" Spacing="18" HorizontalAlignment="Stretch">
        <TextBlock x:Name="SettingsTitleText" Text="设置" Style="{StaticResource DisplayTitleText}" />

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <StackPanel Spacing="14">
            <TextBlock x:Name="AppearanceLanguageTitleText" Text="外观与语言" Style="{StaticResource SectionTitleText}" />
            <Border Style="{StaticResource SettingsInnerCardStyle}">
              <StackPanel>
                <Grid Padding="14" MinHeight="72" ColumnSpacing="24" RowSpacing="10" ColumnDefinitions="*,264" RowDefinitions="Auto,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="ThemeTitleText" Text="主题" Style="{StaticResource SettingsRowLabelStyle}" /><TextBlock x:Name="ThemeDescriptionText" Text="应用主题跟随系统，或固定为浅色/深色。" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
                  <ComboBox x:Name="ThemePicker" Grid.Column="1" Width="250" MinWidth="180" MaxWidth="250" VerticalAlignment="Center" HorizontalAlignment="Right" controls:TransientComboBoxTheme.Apply="True" SelectionChanged="ThemePicker_SelectionChanged"><ComboBoxItem x:Name="ThemeSystemItem" Content="跟随系统" /><ComboBoxItem x:Name="ThemeLightItem" Content="浅色" /><ComboBoxItem x:Name="ThemeDarkItem" Content="深色" /></ComboBox>
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Padding="14" MinHeight="72" ColumnSpacing="24" RowSpacing="10" ColumnDefinitions="*,264" RowDefinitions="Auto,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="LanguageTitleText" Text="语言" Style="{StaticResource SettingsRowLabelStyle}" /><TextBlock x:Name="LanguageDescriptionText" Text="选择界面语言。更改会立即应用，无需重启应用。" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
                  <StackPanel x:Name="LanguagePickerHost" Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                    <ComboBox x:Name="LanguagePicker" Width="250" MinWidth="180" MaxWidth="250" VerticalAlignment="Center" HorizontalAlignment="Right" controls:TransientComboBoxTheme.Apply="True" SelectionChanged="LanguagePicker_SelectionChanged"><ComboBoxItem x:Name="LanguageSystemItem" Content="跟随系统" /><ComboBoxItem x:Name="LanguageZhItem" Content="简体中文" /><ComboBoxItem x:Name="LanguageJaItem" Content="日本語" /><ComboBoxItem x:Name="LanguageEnItem" Content="English" /></ComboBox>
                    <TextBlock x:Name="LanguageStatusText" Visibility="Collapsed" Style="{StaticResource MetadataText}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}">
          <StackPanel Spacing="14">
            <TextBlock x:Name="FileSessionTitleText" Text="文件与会话" Style="{StaticResource SectionTitleText}" />
            <Border Style="{StaticResource SettingsInnerCardStyle}">
              <StackPanel>
                <Grid Padding="14" MinHeight="72" ColumnSpacing="24" RowSpacing="10" ColumnDefinitions="*,264" RowDefinitions="Auto,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="RestoreTitleText" Text="启动时恢复上次会话" Style="{StaticResource SettingsRowLabelStyle}" /><TextBlock x:Name="RestoreDescriptionText" Text="重新打开上次退出时仍在会话中的图纸。" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ToggleSwitch x:Name="RestoreSessionToggle" Grid.Column="1" Width="44" MinWidth="44" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="RestoreSessionToggle_Toggled" /></Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Padding="14" MinHeight="72" ColumnSpacing="24" RowSpacing="10" ColumnDefinitions="*,264" RowDefinitions="Auto,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="RecentTitleText" Text="记录最近打开文件" Style="{StaticResource SettingsRowLabelStyle}" /><TextBlock x:Name="RecentDescriptionText" Text="仅在本机保存最近文件路径，用于主页快速访问。" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ToggleSwitch x:Name="RecentFilesToggle" Grid.Column="1" Width="44" MinWidth="44" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="RecentFilesToggle_Toggled" /></Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Padding="14" MinHeight="72" ColumnSpacing="24" RowSpacing="10" ColumnDefinitions="*,264" RowDefinitions="Auto,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="WatchTitleText" Text="自动检查文件变化" Style="{StaticResource SettingsRowLabelStyle}" /><TextBlock x:Name="WatchDescriptionText" Text="打开的图纸被外部修改后自动重新读取。" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ToggleSwitch x:Name="WatchFilesToggle" Grid.Column="1" Width="44" MinWidth="44" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="WatchFilesToggle_Toggled" /></Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsSectionCardStyle}" Margin="0,0,0,24">
          <StackPanel Spacing="14">
            <TextBlock x:Name="ViewerTitleText" Text="查看器" Style="{StaticResource SectionTitleText}" />
            <Border Style="{StaticResource SettingsInnerCardStyle}">
              <StackPanel>
                <Grid Padding="14" MinHeight="72" ColumnSpacing="24" RowSpacing="10" ColumnDefinitions="*,264" RowDefinitions="Auto,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="FitTitleText" Text="打开文件后适合窗口" Style="{StaticResource SettingsRowLabelStyle}" /><TextBlock x:Name="FitDescriptionText" Text="首次显示图纸时自动缩放到全部对象。" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ToggleSwitch x:Name="FitOnOpenToggle" Grid.Column="1" Width="44" MinWidth="44" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="FitOnOpenToggle_Toggled" /></Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Padding="14" MinHeight="72" ColumnSpacing="24" RowSpacing="10" ColumnDefinitions="*,264" RowDefinitions="Auto,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="DrawingBackgroundTitleText" Text="图纸背景颜色" Style="{StaticResource SettingsRowLabelStyle}" /><TextBlock x:Name="DrawingBackgroundDescriptionText" Text="跟随应用主题，或固定使用黑色/白色画布。" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel><ComboBox x:Name="DrawingBackgroundPicker" Grid.Column="1" Width="250" MinWidth="180" MaxWidth="250" HorizontalAlignment="Right" VerticalAlignment="Center" controls:TransientComboBoxTheme.Apply="True" SelectionChanged="DrawingBackgroundPicker_SelectionChanged"><ComboBoxItem x:Name="DrawingBackgroundFollowItem" Content="跟随应用" /><ComboBoxItem x:Name="DrawingBackgroundDarkItem" Content="黑色" /><ComboBoxItem x:Name="DrawingBackgroundLightItem" Content="白色" /></ComboBox></Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
