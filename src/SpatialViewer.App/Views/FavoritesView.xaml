<UserControl x:Class="SpatialViewer.Product.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SpatialViewer.Product.Controls"
             xmlns:local="using:SpatialViewer.Product.Views">
  <UserControl.Resources>
    <DataTemplate x:Key="FavoriteItemTemplate" x:DataType="local:FavoriteViewItem">
      <Grid Height="80">
        <Button Tag="{x:Bind FilePath}" Click="OpenFavorite_Click"
                Padding="58,12,16,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
          <Grid ColumnDefinitions="72,*,24" ColumnSpacing="16">
            <Border Background="{ThemeResource BgSelectionBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind ExtensionLabel}" Style="{StaticResource TagText}" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind Metadata}" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"
                      Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Tag="{x:Bind FilePath}" Click="RemoveFavorite_Click" Width="36" Height="36" MinWidth="36" Padding="0" Margin="10,0,0,0"
                Background="Transparent" BorderThickness="0" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                ToolTipService.ToolTip="Remove from favorites">
          <FontIcon Glyph="&#xE735;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" Foreground="{ThemeResource AccentBrush}" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Padding="24" RowDefinitions="Auto,16,Auto,14,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" UseLayoutRounding="True">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="TitleText" Text="收藏" Style="{StaticResource DisplayTitleText}" VerticalAlignment="Center" />
        <Button x:Name="AddFavoriteButton" Grid.Column="1" Style="{StaticResource HeaderActionButton}" Click="AddFavoriteButton_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
            <TextBlock x:Name="AddFavoriteButtonText" Text="添加收藏" Style="{StaticResource TabText}" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="*,344" ColumnSpacing="16">
        <TextBlock x:Name="SummaryText" Text="保存经常使用的图纸与空间数据，随时快速打开。" Style="{StaticResource BodyText}"
                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索收藏" TextChanged="SearchBox_TextChanged" />
      </Grid>

      <Grid Grid.Row="4">
        <ItemsControl x:Name="FavoriteItems" ItemsSource="{x:Bind VisibleItems}" ItemTemplate="{StaticResource FavoriteItemTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0" Spacing="10">
          <controls:AppIcon Kind="OpenFile" IconSize="28" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyStateText" Text="还没有收藏。点击“添加收藏”选择常用文件。" Style="{StaticResource BodyText}"
                     Foreground="{ThemeResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
