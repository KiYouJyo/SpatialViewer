<Application x:Class="SpatialViewer.Product.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Themes/Colors.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Shell chrome stays on Mica. The main content surface deliberately differs
           by theme: light mode needs an opaque neutral base so the Mica tint does
           not turn a full-page Layer brush into a muddy gray-green plane, while
           dark mode keeps the existing Fluent layer fill that already reads well. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="Transparent" />
          <StaticResource x:Key="ShellContentBackgroundBrush" ResourceKey="SolidBackgroundFillColorBaseBrush" />
          <SolidColorBrush x:Key="AppTransientSurfaceBrush" Color="#E5F9F9" />
          <StaticResource x:Key="AppTransientSurfaceBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="Transparent" />
          <StaticResource x:Key="ShellContentBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
          <SolidColorBrush x:Key="AppTransientSurfaceBrush" Color="#1A2323" />
          <StaticResource x:Key="AppTransientSurfaceBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="ShellNavigationPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <StaticResource x:Key="ShellContentBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
          <StaticResource x:Key="AppTransientSurfaceBrush" ResourceKey="SystemColorWindowBrush" />
          <StaticResource x:Key="AppTransientSurfaceBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
