<UserControl x:Class="SpatialViewer.Product.Controls.ThreeDmViewportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
  <Grid x:Name="ViewportBackground" Background="Black">
    <canvas:CanvasControl x:Name="ViewportCanvas"
                          Draw="ViewportCanvas_Draw"
                          PointerPressed="Viewport_PointerPressed"
                          PointerMoved="Viewport_PointerMoved"
                          PointerReleased="Viewport_PointerReleased"
                          PointerCanceled="Viewport_PointerCanceled"
                          PointerWheelChanged="Viewport_PointerWheelChanged"
                          SizeChanged="Viewport_SizeChanged" />
  </Grid>
</UserControl>
