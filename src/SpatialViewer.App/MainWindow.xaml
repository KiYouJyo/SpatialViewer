<Window x:Class="SpatialViewer.Product.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="RootGrid" Background="{ThemeResource BgAppBrush}" RowDefinitions="48,*" KeyDown="RootGrid_KeyDown" SizeChanged="RootGrid_SizeChanged" UseLayoutRounding="True">
    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource BgAppBrush}" ColumnDefinitions="104,*,132" Padding="16,0,12,0">
      <TextBlock Text="SpatialViewer" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" />
      <!-- Directly matches PageArc's proven detached 32-DIP title-bar tab shell. -->
      <ScrollViewer Grid.Column="1" Height="32" Margin="0,8,12,8"
                    HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
        <StackPanel x:Name="ShellTabs" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <StackPanel x:Name="ShellTabItems" Orientation="Horizontal" Spacing="8" />
          <Button x:Name="ShellNewTabButton" Width="32" Height="32" MinWidth="32" Padding="0"
                  Background="Transparent" BorderThickness="0" CornerRadius="7"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Click="ShellNewTabButton_Click" AutomationProperties.Name="新建主页标签">
            <TextBlock Text="+" FontSize="17" Opacity="0.68" />
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <NavigationView x:Name="ShellNavigation" Grid.Row="1" Background="{ThemeResource BgAppBrush}"
                    PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="240" CompactPaneLength="52"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="ShellNavigation_SelectionChanged">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0B1716" />
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0B1716" />
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="HomeNav" Tag="Home" Content="主页" IsSelected="True"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="ProjectsNav" Tag="Projects" Content="项目"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="FavoritesNav" Tag="Favorites" Content="收藏"><NavigationViewItem.Icon><SymbolIcon Symbol="Favorite" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="ImportFolderNav" Tag="ImportFolder" Content="导入文件夹"><NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="SettingsNav" Tag="Settings" Content="设置"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="AboutNav" Tag="About" Content="关于图览"><NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <ContentControl x:Name="MainContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
  </Grid>
</Window>
