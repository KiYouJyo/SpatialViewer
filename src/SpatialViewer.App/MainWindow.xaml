<Window x:Class="SpatialViewer.Product.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:present="using:SpatialViewer.Presentation">
  <Grid x:Name="RootGrid" Background="{ThemeResource BgAppBrush}" RowDefinitions="48,*" KeyDown="RootGrid_KeyDown">
    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource BgAppBrush}" ColumnDefinitions="112,*,Auto" Padding="16,8,132,8">
      <TextBlock Text="SpatialViewer" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="HomeTab" Content="⌂   主页" Width="220" Height="32" Style="{StaticResource CompactButton}" Click="HomeTab_Click" />
          <ItemsControl x:Name="DocumentTabs"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="present:DocumentSession"><Grid Width="220" Height="32" Background="{ThemeResource BgSelectionBrush}" CornerRadius="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><Button Content="{Binding DisplayName}" Tag="{Binding}" Click="DocumentTab_Click" ToolTipService.ToolTip="{Binding FilePath}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="12,0" /><Button Grid.Column="1" Content="×" Tag="{Binding}" Click="CloseDocument_Click" Background="Transparent" BorderBrush="Transparent" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Button Content="+" Width="32" Height="32" Background="Transparent" BorderBrush="Transparent" Click="OpenFile_Click" ToolTipService.ToolTip="打开 DWG 或 DXF" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="240,*">
      <StackPanel Background="{ThemeResource BgAppBrush}" Padding="8" Spacing="6">
        <Button Content="☰" Width="40" Height="40" HorizontalAlignment="Left" Style="{StaticResource NavButton}" />
        <Button Content="⌂  主页" Style="{StaticResource NavButton}" Click="HomeTab_Click" />
        <Button Content="▦  项目" Style="{StaticResource NavButton}" Click="Projects_Click" />
        <Button Content="☆  收藏" Style="{StaticResource NavButton}" Click="Favorites_Click" />
        <Grid Height="1" />
        <StackPanel VerticalAlignment="Bottom" Spacing="6">
          <Button Content="▱  导入文件夹" Style="{StaticResource NavButton}" Click="ImportFolder_Click" />
          <Button Content="⚙  设置" Style="{StaticResource NavButton}" Click="Settings_Click" />
          <Button Content="?  关于图览" Style="{StaticResource NavButton}" Click="About_Click" />
        </StackPanel>
      </StackPanel>
      <ContentControl x:Name="MainContent" Grid.Column="1" />
    </Grid>
  </Grid>
</Window>
