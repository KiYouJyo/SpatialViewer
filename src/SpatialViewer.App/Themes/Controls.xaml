<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- State variants are explicit style resources (normal, selected and disabled); all app controls own their templates. -->
  <Style x:Key="CompactActionButton" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="{ThemeResource BgSelectionBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource CompactActionButton}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>

  <Style x:Key="AppTab" TargetType="Button"><Setter Property="Width" Value="220"/><Setter Property="Height" Value="32"/><Setter Property="Background" Value="{ThemeResource BgSurfaceBrush}"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AppTabActive" TargetType="Button" BasedOn="{StaticResource AppTab}"><Setter Property="Background" Value="{ThemeResource BgSelectionBrush}"/></Style>
  <Style x:Key="AppTabAddButton" TargetType="Button" BasedOn="{StaticResource AppTab}"><Setter Property="Width" Value="32"/><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/></Style>
  <Style x:Key="TabIconButton" TargetType="Button" BasedOn="{StaticResource AppTabAddButton}"/>

  <Style x:Key="SideNavItem" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="14,0,10,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SideNavItemSelected" TargetType="Button" BasedOn="{StaticResource SideNavItem}"><Setter Property="Background" Value="{ThemeResource BgSelectionBrush}"/></Style>

  <Style x:Key="WorkflowCard" TargetType="Button"><Setter Property="Height" Value="80"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16,14,16,12"/><Setter Property="Background" Value="{ThemeResource BgToolbarBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="WorkflowCardDisabled" TargetType="Button" BasedOn="{StaticResource WorkflowCard}"><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/></Style>

  <Style x:Key="PanelSegment" TargetType="Button"><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="10,0"/><Setter Property="Background" Value="{ThemeResource BgSurfaceBrush}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PanelSegmentActive" TargetType="Button" BasedOn="{StaticResource PanelSegment}"><Setter Property="Background" Value="{ThemeResource BgSelectionBrush}"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/></Style>

  <Style x:Key="RecentFilterTab" TargetType="Button" BasedOn="{StaticResource PanelSegment}"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="CornerRadius" Value="7"/></Style>
  <Style x:Key="RecentFilterTabSelected" TargetType="Button" BasedOn="{StaticResource RecentFilterTab}"><Setter Property="Background" Value="{ThemeResource BgSelectionBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"><Grid><Border Width="4" Height="24" CornerRadius="2" Background="{ThemeResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/><ContentPresenter Margin="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>

  <Style x:Key="RecentFileRow" TargetType="ListViewItem"><Setter Property="Height" Value="80"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border Background="{ThemeResource BgToolbarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter Margin="16,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AppSearchBox" TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="{ThemeResource BgPanelBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/><Setter Property="PlaceholderForeground" Value="{ThemeResource TextSecondaryBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid><Border x:Name="SearchBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/><ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalContentAlignment="Center"/><TextBlock x:Name="SearchBoxPlaceholder" Margin="12,0" Text="{TemplateBinding PlaceholderText}" Foreground="{TemplateBinding PlaceholderForeground}" VerticalAlignment="Center" IsHitTestVisible="False"/><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="SearchBoxFocusStates"><VisualState x:Name="SearchBoxUnfocused"/><VisualState x:Name="SearchBoxFocused"><VisualState.Setters><Setter Target="SearchBoxBorder.BorderBrush" Value="{ThemeResource AccentBrush}"/></VisualState.Setters></VisualState></VisualStateGroup><VisualStateGroup x:Name="SearchBoxPlaceholderStates"><VisualState x:Name="PlaceholderTextVisible"/><VisualState x:Name="PlaceholderTextCollapsed"><VisualState.Setters><Setter Target="SearchBoxPlaceholder.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DropZone" TargetType="Button" BasedOn="{StaticResource WorkflowCard}"><Setter Property="Height" Value="44"/><Setter Property="Background" Value="{ThemeResource BgPanelBrush}"/><Setter Property="Padding" Value="16,0"/></Style>
</ResourceDictionary>
