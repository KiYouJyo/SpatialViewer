<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Keep WinUI's native templates and visual states; styles only set sizing and theme resources. -->
  <Style x:Key="CompactActionButton" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{ThemeResource BgSelectionBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style x:Key="HeaderActionButton" TargetType="Button" BasedOn="{StaticResource CompactActionButton}">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="AppTab" TargetType="Button">
    <Setter Property="Width" Value="220" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{ThemeResource BgSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style x:Key="AppTabActive" TargetType="Button" BasedOn="{StaticResource AppTab}">
    <Setter Property="Background" Value="{ThemeResource BgSelectionBrush}" />
  </Style>
  <Style x:Key="AppTabAddButton" TargetType="Button" BasedOn="{StaticResource AppTab}">
    <Setter Property="Width" Value="32" />
  </Style>
  <Style x:Key="TabIconButton" TargetType="Button" BasedOn="{StaticResource AppTabAddButton}" />

  <Style x:Key="SideNavItem" TargetType="Button">
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="14,0,10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style x:Key="SideNavItemSelected" TargetType="Button" BasedOn="{StaticResource SideNavItem}">
    <Setter Property="Background" Value="{ThemeResource BgSelectionBrush}" />
  </Style>

  <Style x:Key="WorkflowCard" TargetType="Button">
    <Setter Property="Height" Value="80" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="16,14,16,12" />
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Settings/About deliberately use WinUI's neutral Fluent card resources.
       The older BgPanel/BgSelection palette is product accent chrome and must not
       tint ordinary content cards teal. This mirrors UrbanPlanToolbox. -->
  <Style x:Key="SettingsSectionCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="SettingsInnerCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="SettingsRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource MetadataText}">
    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="PanelSegment" TargetType="Button">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{ThemeResource BgSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="PanelSegmentActive" TargetType="Button" BasedOn="{StaticResource PanelSegment}">
    <Setter Property="Background" Value="{ThemeResource BgSelectionBrush}" />
  </Style>

  <!-- Recent file cards follow UrbanPlanToolbox's native Button card style: sizing only,
       leaving WinUI's theme, hover, pressed and focus states intact. -->
  <Style x:Key="RecentFileCard" TargetType="Button">
    <Setter Property="Height" Value="80" />
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style x:Key="DropZone" TargetType="Button" BasedOn="{StaticResource WorkflowCard}">
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="{ThemeResource BgPanelBrush}" />
    <Setter Property="Padding" Value="16,0" />
  </Style>
</ResourceDictionary>
