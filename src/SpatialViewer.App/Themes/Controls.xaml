<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable, Microsoft YaHei UI, Yu Gothic UI" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /></Style>
  <Style x:Key="CompactButton" TargetType="Button"><Setter Property="Background" Value="{ThemeResource BgSelectionBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="12,7" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /></Style>
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource CompactButton}"><Setter Property="Width" Value="44" /><Setter Property="Height" Value="43" /><Setter Property="Padding" Value="0" /></Style>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Padding" Value="16,10" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" /></Style>
</ResourceDictionary>
