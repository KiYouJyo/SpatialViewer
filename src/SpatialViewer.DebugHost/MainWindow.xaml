<Window x:Class="SpatialViewer.DebugHost.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml" Title="Spatial Viewer — Debug Host">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="180,*">
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Padding="8"><Button Content="Fit" Click="Fit_Click"/><Button Content="Reset" Click="Reset_Click"/><ComboBox x:Name="ScenePicker" Width="180" SelectedIndex="0" SelectionChanged="ScenePicker_SelectionChanged"><ComboBoxItem Content="Basic primitives"/><ComboBoxItem Content="Nested transforms"/><ComboBoxItem Content="Large coordinates"/><ComboBoxItem Content="Stress 100K"/><ComboBoxItem Content="Stress 1M"/></ComboBox></StackPanel>
    <StackPanel Grid.Row="1" Spacing="8" Padding="12"><TextBlock Text="Layers" FontWeight="SemiBold"/><ListView x:Name="LayerList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Click="Layer_Click"/></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="SelectionText" Text="Selection: none" TextWrapping="Wrap"/><TextBlock x:Name="DiagnosticsText" Text="Diagnostics: ready" TextWrapping="Wrap"/></StackPanel>
    <canvas:CanvasControl x:Name="ViewportCanvas" Grid.Row="1" Grid.Column="1" PointerPressed="Viewport_PointerPressed" PointerMoved="Viewport_PointerMoved" PointerReleased="Viewport_PointerReleased" PointerWheelChanged="Viewport_PointerWheelChanged" SizeChanged="Viewport_SizeChanged" />
    <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="8" BorderThickness="0,1,0,0" BorderBrush="Gray"><StackPanel Orientation="Horizontal" Spacing="18"><TextBlock x:Name="FpsText" Text="Frame: --"/><TextBlock x:Name="ObjectsText"/><TextBlock x:Name="ZoomText"/><TextBlock x:Name="CoordinateText"/></StackPanel></Border>
  </Grid>
</Window>
